# Coverage settings for `coverage run --branch -m pytest`; see docs/testing.md.
[run]
branch = true
source = buy_agent
# Measured but, unlike `source`, not mutated, linted or type-checked (ADR-0064).
source_dirs =
    benchmark
    scripts

[report]
show_missing = true
fail_under = 99
exclude_also =
    # Runs only under `python -m buy_agent`, which tests/test_cli.py spawns.
    if __name__ == .__main__.:
