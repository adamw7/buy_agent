# Coverage settings, read by the gate's `pytest -n 3 --cov` (ADR-0076) and by
# `coverage run -m pytest` alike; see docs/testing.md.
[run]
branch = true
source = buy_agent
# Measured but, unlike `source`, not mutated, linted or type-checked (ADR-0064).
source_dirs =
    benchmark
    scripts

[report]
show_missing = true
fail_under = 99
exclude_also =
    # Runs only under `python -m buy_agent`, which tests/test_cli.py spawns.
    if __name__ == .__main__.:
