# Everything the build does not need. The two stages copy `ui/` and then
# `requirements.txt` plus `buy_agent/`; anything else here only slows the
# context upload down or, worse, ends up in the image.

.git/
.github/
.claude/
.gitignore
.dockerignore
Dockerfile

# Built or installed locally: the image builds its own copies from source. Read
# off `.gitignore`, which is the list of what working in this repository leaves
# behind -- and what is left behind is what the build has least use for. Every
# spelling of the virtualenv, not just the one the README makes, since the build
# context is uploaded whole and a stray `venv/` is the largest thing here.
.venv/
venv/
env/
ENV/
ui/node_modules/
ui/dist/
ui/.angular/
**/__pycache__/
*.py[codz]
.pytest_cache/
mutation-results.txt
*.log

# Never built, never copied, and the one thing here worth keeping out of a build
# context on purpose: the image gets its settings from the environment it is run
# in (`docs/docker.md`), never from a file somebody left in the checkout.
.env
.envrc

# Tests, the benchmark, coverage, mutation testing, docs and the recorded demo:
# none of them run in the image, and demo/ carries a video the size of the rest
# put together.
demo/
tests/
integration/
benchmark/
docs/
scripts/
mutants/
setup.cfg
requirements-mutation.txt
# The AP2 SDK is an optional install and the image does not make it: a container
# that is asked to pay says which one command adds it (`buy_agent.mandates`).
requirements-ap2.txt
requirements-ap2-deps.txt
.coverage
.coverage.*
coverage.xml
.coveragerc
coverage/
htmlcov/
pytest.ini
requirements-dev.txt
*.md

# Renovate's config: read by the bot on GitHub, by nothing in the image.
renovate.json5
