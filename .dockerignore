# Everything the build does not need: it copies `ui/`, `requirements.txt` and
# `buy_agent/` only.

.git/
.github/
.claude/
.gitignore
.dockerignore
Dockerfile

# Everything `.gitignore` names, plus the UI's leavings from `ui/.gitignore`.
.venv/
venv/
env/
ENV/
ui/node_modules/
ui/dist/
ui/.angular/
ui/coverage/
ui/reports/
ui/.stryker-tmp/
**/__pycache__/
*.py[codz]
*$py.class
.pytest_cache/
.mypy_cache/
mutation-results.txt
*.log

# Settings come from the environment the container runs in, never a file.
.env
.envrc

