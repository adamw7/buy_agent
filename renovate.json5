{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',

  // Without this file Renovate watched only `.github/workflows/`. Actions and images
  // are pinned by digest, which a tag can be moved off and a digest cannot (ADR-0092).
  extends: [
    'config:recommended',
    'helpers:pinGitHubActionDigests',
    'docker:pinDigests',
  ],

  // The dashboard records what is pending, even when nothing is raised.
  dependencyDashboard: true,

  // Every pin is exact and deprecations are errors, so moving a pin is tested.
  enabledManagers: [
    'github-actions',
    'dockerfile',
    'npm',
    'pip_requirements',
    // requirements.lock, regenerated by the command its header names (ADR-0092).
    'pip-compile',
    // compose.yaml's model server and search engine.
    'docker-compose',
    // The toolchains every workflow and script reads: .nvmrc and .python-version.
    'nvm',
    'pyenv',
  ],

  // The default pattern misses this name (two words after "requirements").
  pip_requirements: {
    managerFilePatterns: ['/(^|/)requirements-ap2-deps\\.txt$/'],
  },

  // The lock is an output: Renovate moves a pin in requirements.txt and regenerates
  // the lock in the same branch, and refreshes what it pulls in once a week -- this
  // lock only, not the UI's.
  'pip-compile': {
    managerFilePatterns: ['/(^|/)requirements\\.lock$/'],
    lockFileMaintenance: {
      enabled: true,
    },
  },

  packageRules: [
    {
      // @angular/build peer-depends on vitest ^4 until 22.2 is stable (#144).
      // A hold gates only a branch's creation, so closing a held pull request
      // means deleting its branch too (#199).
      matchManagers: ['npm'],
      matchPackageNames: ['vitest', '@vitest/**'],
      matchUpdateTypes: ['major'],
      dependencyDashboardApproval: true,
    },
    {
      // Angular 22 peer-depends on TypeScript <6.1; 7.0 is the Go rewrite (#142).
      matchManagers: ['npm'],
      matchPackageNames: ['typescript'],
      matchUpdateTypes: ['major'],
      dependencyDashboardApproval: true,
    },
    {
      // .nvmrc and the Dockerfile's base image move together; a convention test
      // holds the image to the file.
      matchDepNames: ['node'],
      groupName: 'Node',
      commitMessageTopic: 'Node',
    },
    {
      // The same, for Python.
      matchDepNames: ['python'],
      groupName: 'Python',
      commitMessageTopic: 'Python',
    },
  ],
}
