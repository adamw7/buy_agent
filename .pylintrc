# pylint over `buy_agent/`, run from the repository root by ci.yml (ADR-0048). A
# check turned off is one this project answers differently, with the answer here;
# a check firing once is suppressed on its line, with its reason there.

[MAIN]
# `fetch.py` catches `lxml.etree.ParserError`, which lives in a C extension.
extension-pkg-allow-list = lxml.etree

# Optional installs whose imports are deferred: the AP2 SDK and the two libraries it
# signs with (ADR-0046), and Playwright (ADR-0065). Unresolvable on most checkouts.
ignored-modules = ap2, jwcrypto, cryptography, playwright

# Fifteen of the twenty-five optional checkers, each a rule the package already
# holds; what they found was fixed, not configured around (ADR-0049). Left out:
# `magic_value` (the numbers are argued for beside them), `broad_try_clause`
# (`minor_units` explains its guard), `code_style` (walrus as house style),
# `mccabe` (declined in `tests/test_architecture.py`), `while_used` and
# `consider_refactoring_into_while_condition` (the two polling loops),
# `no_self_use` (`BuyAgentHandler._models` is one of a family of routes), and
# `bad_builtin`, `set_membership` and `consider_ternary_expression` (taste).
load-plugins =
    # A docstring section somebody wrote must be true of the code; no bare `#`.
    pylint.extensions.docparams,
    pylint.extensions.docstyle,
    pylint.extensions.empty_comment,
    # Exceptions, names and loop variables: no ancestor beside its own child.
    pylint.extensions.overlapping_exceptions,
    pylint.extensions.redefined_loop_name,
    pylint.extensions.redefined_variable_type,
    pylint.extensions.dunder,
    pylint.extensions.eq_without_hash,
    # Control flow that reads as what it does.
    pylint.extensions.check_elif,
    pylint.extensions.confusing_elif,
    pylint.extensions.comparison_placement,
    pylint.extensions.dict_init_mutate,
    pylint.extensions.for_any_all,
    # No `_name` from another package, and no `typing` alias 3.14 has a builtin for.
    pylint.extensions.private_import,
    pylint.extensions.typing

[FORMAT]
max-line-length = 100

[MESSAGES CONTROL]
enable =
    # A suppression that suppresses nothing fails, and names its check by name.
    useless-suppression,
    use-symbolic-message-instead,
    # Every way a check can stop running quietly. `locally-disabled` and
    # `suppressed-message` stay off: they fire on every pragma doing its job.
    bad-inline-option,
    deprecated-pragma,
    file-ignored,
    raw-checker-failed,

disable =
    # Function docstrings would restate names; module and class ones are required.
    missing-function-docstring,
    # "A stand-in is a class with one method" is the seam (`ChatModel`, `Closable`).
    too-few-public-methods,
    # Declarations: `AgentConfig` has a field per setting, a table row one per
    # difference between servers or counterparties (ADR-0029, ADR-0046).
    too-many-instance-attributes,

[DESIGN]
# Where the package stands today: `fetch.enrich` is handed its settings and its
# clock rather than reading them (ADR-0047, ADR-0053).
max-args = 7
max-locals = 17
